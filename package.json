{
  "name": "ear-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:mobile": "CAPACITOR_BUILD=1 tsc && CAPACITOR_BUILD=1 vite build",
    "build:web": "WEB_APP_BUILD=1 tsc && WEB_APP_BUILD=1 vite build",
    "build:tool:cof": "esbuild site/tools/circle-of-fifths/_src/main.jsx --bundle --loader:.jsx=jsx --tsconfig-raw='{\"compilerOptions\":{\"jsx\":\"react\"}}' --target=es2017 --minify --legal-comments=none --outfile=site/tools/circle-of-fifths/circle-of-fifths.js",
    "build:tool:vrt": "esbuild site/tools/vocal-range-test/_src/main.jsx --bundle --format=iife --loader:.jsx=jsx --tsconfig-raw='{\"compilerOptions\":{\"jsx\":\"react\"}}' --target=es2017 --minify --legal-comments=none --outfile=site/tools/vocal-range-test/vocal-range-test.js",
    "build:tool:intervals": "esbuild site/tools/interval-ear-trainer/_src/main.jsx --bundle --loader:.jsx=jsx --tsconfig-raw='{\"compilerOptions\":{\"jsx\":\"react\"}}' --target=es2017 --minify --legal-comments=none --outfile=site/tools/interval-ear-trainer/interval-ear-trainer.js",
    "build:tool:notes": "esbuild site/tools/_note-games/game.jsx --bundle --loader:.jsx=jsx --tsconfig-raw='{\"compilerOptions\":{\"jsx\":\"react\"}}' --target=es2017 --minify --legal-comments=none --outfile=site/tools/_note-games/note-games.js",
    "build:tool:piano": "esbuild site/tools/piano-notes/_src/main.jsx --bundle --loader:.jsx=jsx --tsconfig-raw='{\"compilerOptions\":{\"jsx\":\"react\"}}' --target=es2017 --minify --legal-comments=none --outfile=site/tools/piano-notes/piano-notes.js",
    "build:tool:fretboard": "esbuild site/tools/guitar-fretboard-notes/_src/main.jsx --bundle --loader:.jsx=jsx --tsconfig-raw='{\"compilerOptions\":{\"jsx\":\"react\"}}' --target=es2017 --minify --legal-comments=none --outfile=site/tools/guitar-fretboard-notes/guitar-fretboard-notes.js",
    "build:tool:fretintervals": "esbuild site/tools/guitar-fretboard-intervals/_src/main.jsx --bundle --loader:.jsx=jsx --tsconfig-raw='{\"compilerOptions\":{\"jsx\":\"react\"}}' --target=es2017 --minify --legal-comments=none --outfile=site/tools/guitar-fretboard-intervals/guitar-fretboard-intervals.js",
    "build:tools": "npm run build:tool:cof && npm run build:tool:vrt && npm run build:tool:intervals && npm run build:tool:notes && npm run build:tool:piano && npm run build:tool:fretboard && npm run build:tool:fretintervals",
    "cap:sync": "npm run build:mobile && cap sync",
    "ios": "npm run build:mobile && cap sync ios && cap open ios",
    "android": "npm run build:mobile && cap sync android && cap open android",
    "ios:run": "npm run build:mobile && cap sync ios && cap run ios",
    "android:run": "npm run build:mobile && cap sync android && cap run android",
    "sync:site-brand": "rsync -a --delete public/brand/ site/brand/",
    "build:blog": "node scripts/build-blog.mjs",
    "predeploy:site": "npm run sync:site-brand && npm run build:blog && npm run build:tools",
    "deploy:site": "wrangler pages deploy"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@revenuecat/purchases-capacitor": "^9.2.2",
    "@revenuecat/purchases-js": "^1.36.0",
    "@sentry/react": "^10.50.0",
    "@sentry/vite-plugin": "^5.2.0",
    "@supabase/supabase-js": "^2.104.1",
    "lucide-react": "^0.294.0",
    "pitchfinder": "^2.3.4",
    "pitchy": "^4.1.0",
    "posthog-js": "^1.372.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tone": "^14.7.77"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.2",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
