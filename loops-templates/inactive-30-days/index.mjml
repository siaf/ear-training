<mjml>
  <mj-head>
    <mj-title>What got in the way?</mj-title>
    <mj-preview>One line back would really help us.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text line-height="1.55" font-size="15px" color="#54466b" padding="0 0 12px" />
      <mj-button background-color="#ff8a6b" color="#ffffff" border-radius="999px" padding="0" font-weight="600" font-size="16px" inner-padding="14px 32px" />
    </mj-attributes>
    <mj-style inline="inline">
      .h1 { font-family: Georgia, 'DM Serif Display', serif; font-weight: 600; font-size: 28px; line-height: 1.15; letter-spacing: -0.02em; color: #2a1d3a; margin: 0; }
      .h3 { font-family: Georgia, 'DM Serif Display', serif; font-weight: 600; font-style: italic; font-size: 18px; line-height: 1.3; color: #2a1d3a; margin: 0; }
      .accent { font-style: italic; color: #c64632; }
      .meta { font-size: 11px; color: #b7acc4; }
      .small { font-size: 12px; color: #8a7b9d; line-height: 1.55; }
      .pill { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #e6defa; color: #5b3fa6; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
      .label { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }
      a.contact, a.unsub { color: #54466b; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fff8ef" width="560px">
    <mj-section padding="32px 0 8px">
      <mj-column>
        <mj-image src="img/logo.png" width="120px" align="left" padding="0" alt="Fifths" />
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="24px" padding="32px">
      <mj-section padding="0">
        <mj-group>
          <mj-column width="65%">
            <mj-text padding="0 0 10px"><span class="pill">a month since your last lesson</span></mj-text>
            <mj-text padding="0 0 12px"><span class="h1">What got <span class="accent">in the way</span>?</span></mj-text>
            <mj-text padding="0 0 12px">It's been a month since your last lesson. If something put you off (a lesson that felt too hard, the singing, not enough time), just reply and tell us.</mj-text>
            <mj-text padding="0">One line is plenty. We read every reply, and it shapes what we build next.</mj-text>
          </mj-column>
          <mj-column width="35%">
            <mj-image src="img/mascot.png" width="140px" align="right" padding="0" alt="Noir" />
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="24px 0 0">
        <mj-column>
          <mj-button href="{EVENT_PROPERTY:appUrl}" align="left">Or try one lesson →</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="20px 16px 0">
      <mj-column>
        <mj-text align="center" padding="0 0 6px"><span class="small">You're getting this because you practised with Fifths about a month ago. Replies go straight to the team.</span></mj-text>
        <mj-text align="center" padding="0 0 6px"><span class="small">Questions? <a class="contact" href="mailto:hello@fifths.io">hello@fifths.io</a></span></mj-text>
        <mj-text align="center" padding="6px 0 6px"><span class="meta">ear training that tells you what you keep missing</span></mj-text>
        <mj-text align="center" padding="0"><span class="small"><a class="unsub" href="{unsubscribe_link}">Unsubscribe</a></span></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
