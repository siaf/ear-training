<mjml>
  <mj-head>
    <mj-title>Your week in Fifths</mj-title>
    <mj-preview>Last week: minutes practiced, top intervals, weakest one to attack this week.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text line-height="1.55" font-size="15px" color="#54466b" padding="0 0 12px" />
      <mj-button background-color="#ff8a6b" color="#ffffff" border-radius="999px" padding="14px 32px" font-weight="600" font-size="16px" inner-padding="14px 32px" />
    </mj-attributes>
    <mj-style inline="inline">
      .h1 { font-family: Georgia, 'DM Serif Display', serif; font-weight: 600; font-size: 28px; line-height: 1.15; letter-spacing: -0.02em; color: #2a1d3a; margin: 0; }
      .h3 { font-family: Georgia, 'DM Serif Display', serif; font-weight: 600; font-style: italic; font-size: 18px; color: #2a1d3a; margin: 0; }
      .accent { font-style: italic; color: #c64632; }
      .meta { font-size: 11px; color: #b7acc4; }
      .small { font-size: 12px; color: #8a7b9d; line-height: 1.55; }
      .pill { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #dcecff; color: #2867b2; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
      .stat-num { font-family: Georgia, 'DM Serif Display', serif; font-size: 32px; font-weight: 600; color: #2a1d3a; line-height: 1; }
      .stat-label { font-size: 11px; color: #8a7b9d; text-transform: uppercase; letter-spacing: 1px; }
      .label { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }
      a.contact, a.unsub { color: #54466b; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fff8ef" width="560px">
    <mj-section padding="32px 0 8px">
      <mj-column>
        <mj-image src="img/logo.png" width="120px" align="left" padding="0" alt="Fifths" />
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="24px" padding="32px">
      <mj-section padding="0">
        <mj-group>
          <mj-column width="65%">
            <mj-text padding="0 0 10px"><span class="pill">your week</span></mj-text>
            <mj-text padding="0"><span class="h1">Last week, your ear <span class="accent">moved</span>.</span></mj-text>
          </mj-column>
          <mj-column width="35%">
            <mj-image src="img/mascot.png" width="130px" align="right" padding="0" alt="Pulse" />
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="20px 0 0">
        <mj-group>
          <mj-column width="50%">
            <mj-text padding="0 0 4px"><span class="stat-label">minutes practiced</span></mj-text>
            <mj-text padding="0"><span class="stat-num">{DATA_VARIABLE:minutesPracticed}</span></mj-text>
          </mj-column>
          <mj-column width="50%">
            <mj-text padding="0 0 4px"><span class="stat-label">streak</span></mj-text>
            <mj-text padding="0"><span class="stat-num">🔥 {DATA_VARIABLE:streakDays}</span></mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="16px 0 0">
        <mj-column background-color="#d5f0e1" border-radius="14px" padding="16px 18px">
          <mj-text padding="0 0 6px"><span class="stat-label">strongest this week</span></mj-text>
          <mj-text padding="0 0 4px"><span class="stat-num" style="color:#2f7a5a">{DATA_VARIABLE:topInterval}</span></mj-text>
          <mj-text padding="0" font-size="13px" color="#2f7a5a">Confident and consistent. Use it as an anchor.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="12px 0 0">
        <mj-column background-color="#ffe1d4" border-radius="14px" padding="16px 18px">
          <mj-text padding="0 0 6px"><span class="stat-label">attack this week</span></mj-text>
          <mj-text padding="0 0 4px"><span class="stat-num" style="color:#c64632">{DATA_VARIABLE:weakestInterval}</span></mj-text>
          <mj-text padding="0" font-size="13px" color="#c64632">Slipping more than you think. We'll lean on it for the next few sessions.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="24px 0 0">
        <mj-column>
          <mj-button href="https://app.fifths.io" align="left">Pick up where you left off →</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#e4daff" border-radius="18px" padding="22px 26px" css-class="coda">
      <mj-column>
        <mj-text padding="0 0 6px"><span class="label" style="color:#5b3fb3">this week's micro-challenge</span></mj-text>
        <mj-text padding="0 0 12px"><span class="h3">Hum your weakness before you tap.</span></mj-text>
        <mj-text padding="0" font-size="14px" color="#2a1d3a">When you hear <strong>{DATA_VARIABLE:weakestInterval}</strong> in a drill, hum it back at yourself before clicking the answer. Even silently. The act of producing the interval — not just identifying it — wires recognition way faster than passive listening alone.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 0 0">
      <mj-column>
        <mj-text align="center" padding="0 0 6px"><span class="small">Don't want the Sunday digest? Reply "no digest" and we'll mute it.</span></mj-text>
        <mj-text align="center" padding="0 0 6px"><span class="small"><a class="contact" href="mailto:hello@fifths.io">hello@fifths.io</a></span></mj-text>
        <mj-text align="center" padding="6px 0 6px"><span class="meta">ear training that tells you what you keep missing</span></mj-text>
        <mj-text align="center" padding="0"><span class="small"><a class="unsub" href="{unsubscribe_link}">Unsubscribe</a></span></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
