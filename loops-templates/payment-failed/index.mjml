<mjml>
  <mj-head>
    <mj-title>Your Fifths Pro payment didn't go through</mj-title>
    <mj-preview>Common cause: card expired or insufficient funds. Update in 60 seconds and you're back.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text line-height="1.55" font-size="15px" color="#54466b" padding="0 0 12px" />
      <mj-button background-color="#ff8a6b" color="#ffffff" border-radius="999px" padding="14px 32px" font-weight="600" font-size="16px" inner-padding="14px 32px" />
    </mj-attributes>
    <mj-style inline="inline">
      .h1 { font-family: Georgia, 'DM Serif Display', serif; font-weight: 600; font-size: 28px; line-height: 1.15; letter-spacing: -0.02em; color: #2a1d3a; margin: 0; }
      .accent { font-style: italic; color: #c64632; }
      .meta { font-size: 11px; color: #b7acc4; }
      .small { font-size: 12px; color: #8a7b9d; line-height: 1.55; }
      .pill { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #ffe1d4; color: #c64632; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
      .label { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }
      a.contact { color: #54466b; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fff8ef" width="560px">
    <mj-section padding="32px 0 8px">
      <mj-column>
        <mj-image src="img/logo.png" width="120px" align="left" padding="0" alt="Fifths" />
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="24px" padding="32px">
      <mj-section padding="0">
        <mj-group>
          <mj-column width="65%">
            <mj-text padding="0 0 10px"><span class="pill">payment didn't go through</span></mj-text>
            <mj-text padding="0 0 12px"><span class="h1">Quick — your <span class="accent">card was declined</span>.</span></mj-text>
            <mj-text padding="0">Stripe just tried to renew your Fifths Pro subscription and the charge didn't go through. Your access is still active for now — we'll retry on <strong>{DATA_VARIABLE:nextRetryDate}</strong>.</mj-text>
          </mj-column>
          <mj-column width="35%">
            <mj-image src="img/mascot.png" width="140px" align="right" padding="0" alt="Major" />
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="24px 0 0">
        <mj-column>
          <mj-button href="{DATA_VARIABLE:updateUrl}" align="left">Update payment →</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#fef1dd" border-radius="18px" padding="20px 26px" css-class="coda">
      <mj-column>
        <mj-text padding="0 0 6px"><span class="label" style="color:#9a6f00">most common causes</span></mj-text>
        <mj-text padding="0" font-size="14px" color="#2a1d3a">Card expired · card was reissued (new number, new expiry) · temporary bank block on a recurring charge · address-verification mismatch. Every one of those is a 60-second fix in the link above.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 0 0">
      <mj-column>
        <mj-text align="center" padding="0 0 6px"><span class="small">If you'd rather not continue, just ignore this — Pro will end after the retry fails. No charge, no awkwardness.</span></mj-text>
        <mj-text align="center" padding="0 0 6px"><span class="small"><a class="contact" href="mailto:hello@fifths.io">hello@fifths.io</a></span></mj-text>
        <mj-text align="center" padding="6px 0"><span class="meta">ear training that tells you what you keep missing</span></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
