<mjml>
  <mj-head>
    <mj-title>Your Fifths Pro subscription is cancelled</mj-title>
    <mj-preview>Your data stays. Pro access continues until the end of the period. Easy to come back.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text line-height="1.55" font-size="15px" color="#54466b" padding="0 0 12px" />
      <mj-button background-color="#ff8a6b" color="#ffffff" border-radius="999px" padding="14px 32px" font-weight="600" font-size="16px" inner-padding="14px 32px" />
    </mj-attributes>
    <mj-style inline="inline">
      .h1 { font-family: Georgia, 'DM Serif Display', serif; font-weight: 600; font-size: 28px; line-height: 1.15; letter-spacing: -0.02em; color: #2a1d3a; margin: 0; }
      .h3 { font-family: Georgia, 'DM Serif Display', serif; font-weight: 600; font-style: italic; font-size: 18px; color: #2a1d3a; margin: 0; }
      .accent { font-style: italic; color: #c64632; }
      .meta { font-size: 11px; color: #b7acc4; }
      .small { font-size: 12px; color: #8a7b9d; line-height: 1.55; }
      .pill { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #ebe1ef; color: #54466b; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
      .label { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }
      a.contact { color: #54466b; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#fff8ef" width="560px">
    <mj-section padding="32px 0 8px">
      <mj-column>
        <mj-image src="img/logo.png" width="120px" align="left" padding="0" alt="Fifths" />
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="24px" padding="32px">
      <mj-section padding="0">
        <mj-group>
          <mj-column width="65%">
            <mj-text padding="0 0 10px"><span class="pill">subscription cancelled</span></mj-text>
            <mj-text padding="0 0 12px"><span class="h1">Cancelled. Thanks for <span class="accent">trying</span> us.</span></mj-text>
            <mj-text padding="0">Your Fifths Pro subscription won't renew. You keep Pro access until <strong>{DATA_VARIABLE:accessUntilDate}</strong>, then you'll automatically drop to the free tier. Your practice data — sessions, mastery, streaks — stays put for 90 days.</mj-text>
          </mj-column>
          <mj-column width="35%">
            <mj-image src="img/mascot.png" width="140px" align="right" padding="0" alt="Fable" />
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="24px 0 0">
        <mj-column>
          <mj-button href="{DATA_VARIABLE:resubUrl}" align="left">Reactivate Pro →</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#e4daff" border-radius="18px" padding="22px 26px" css-class="coda">
      <mj-column>
        <mj-text padding="0 0 6px"><span class="label" style="color:#5b3fb3">what we're working on</span></mj-text>
        <mj-text padding="0 0 12px"><span class="h3">Things you might want to come back for.</span></mj-text>
        <mj-text padding="0 0 8px" font-size="14px" color="#2a1d3a">→ <strong>Mic-input scoring</strong> for sing-back drills — sing the interval back, get cents-accuracy feedback in real time.</mj-text>
        <mj-text padding="0 0 8px" font-size="14px" color="#2a1d3a">→ <strong>More curriculum segments</strong> — modes, rhythm, advanced jazz voicings, chord progressions in context.</mj-text>
        <mj-text padding="0" font-size="14px" color="#2a1d3a">→ <strong>iOS + Android apps</strong> — practice on the train without a browser tab.</mj-text>
        <mj-text padding="14px 0 0" font-size="13px" color="#54466b">If something specific drove you away, we'd genuinely love to know. Just reply to this email — we read every one and your feedback shapes what we build next.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 0 0">
      <mj-column>
        <mj-text align="center" padding="0 0 6px"><span class="small"><a class="contact" href="mailto:hello@fifths.io">hello@fifths.io</a></span></mj-text>
        <mj-text align="center" padding="6px 0"><span class="meta">ear training that tells you what you keep missing</span></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
